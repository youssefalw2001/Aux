{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["../worker-configuration.d.ts"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  // Only the genuinely shared, environment-agnostic modules. Pulling in all of
  // src/lib/room would drag in useRoom.ts, which is browser-only.
  "include": [
    "**/*.ts",
    "../src/lib/room/protocol.ts",
    "../src/lib/prompts.ts"
  ],
  "exclude": ["node_modules"]
}
