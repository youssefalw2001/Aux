{
  "name": "aux",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc -p worker/tsconfig.json --noEmit",
    "build:pages": "PAGES_BUILD=1 next build && node scripts/postexport.mjs",
    "dev:worker": "wrangler dev",
    "deploy:worker": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "test:room": "bash scripts/room-test.sh",
    "smoke": "bash scripts/smoke.sh",
    "cards": "bash scripts/card-verify.sh",
    "check:browser": "bash scripts/browser-check.sh",
    "shots": "bash scripts/page-shots.sh",
    "test:clicks": "bash scripts/click-test.sh",
    "verify": "pnpm typecheck && pnpm lint && node scripts/run-audit.mjs && bash scripts/prod-verify.sh && bash scripts/pages-verify.sh && bash scripts/click-test.sh && bash scripts/browser-check.sh && bash scripts/room-test.sh",
    "test:daily": "node scripts/run-audit.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "motion": "^13.1.0",
    "nanoid": "^6.0.1",
    "next": "16.3.1",
    "partyserver": "^0.5.10",
    "partysocket": "^1.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260818.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.123.0"
  },
  "packageManager": "pnpm@10.28.1"
}
